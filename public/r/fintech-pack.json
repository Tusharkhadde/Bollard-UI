{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "fintech-pack",
  "title": "Fintech Pack",
  "description": "Payment and transfer safeguards in one install.",
  "registryDependencies": [
    "@bollard/amount-input",
    "@bollard/duplicate-payment-guard",
    "@bollard/bank-transfer-timing",
    "@bollard/charge-summary"
  ],
  "files": [
    {
      "path": "registry/default/fintech-pack/pack.ts",
      "content": "export const fintechPack = [\"amount-input\", \"duplicate-payment-guard\", \"bank-transfer-timing\", \"charge-summary\"] as const\n",
      "type": "registry:ui",
      "target": "@components/fintech-pack/pack.ts"
    }
  ],
  "meta": {
    "flows": [
      "checkout"
    ],
    "fields": [
      "amount"
    ],
    "summary": "A pack for safer amounts, transfers, charges and duplicate payments.",
    "catches": [
      "Extra-zero amounts",
      "Duplicate payment attempts"
    ],
    "limits": [
      "Validate every payment server-side."
    ],
    "a11y": [
      "Included components provide accessible labels and status."
    ],
    "usage": "npx shadcn@4.21.0 add @bollard/fintech-pack",
    "runtimeDependencies": [],
    "zeroRuntimeDependencies": true
  },
  "docs": "https://bollard-ui.vercel.app/components/fintech-pack",
  "categories": [
    "Starter packs"
  ],
  "type": "registry:ui"
}
