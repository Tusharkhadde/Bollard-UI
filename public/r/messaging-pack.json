{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "messaging-pack",
  "title": "Messaging Pack",
  "description": "Review recipients, attachments and sensitive text before sending.",
  "registryDependencies": [
    "@bollard/reply-all-guard",
    "@bollard/recipient-check",
    "@bollard/attachment-nudge",
    "@bollard/grace-send",
    "@bollard/secret-paste-guard"
  ],
  "files": [
    {
      "path": "registry/default/messaging-pack/pack.ts",
      "content": "export const messagingPack = [\"reply-all-guard\", \"recipient-check\", \"attachment-nudge\", \"grace-send\", \"secret-paste-guard\"] as const\n",
      "type": "registry:ui",
      "target": "@components/messaging-pack/pack.ts"
    }
  ],
  "meta": {
    "flows": [
      "messaging"
    ],
    "fields": [
      "text"
    ],
    "summary": "A safety pack for messages and sharing.",
    "catches": [
      "Wrong recipients",
      "Forgotten attachments"
    ],
    "limits": [
      "Enforce sharing policy server-side."
    ],
    "a11y": [
      "Included components offer visible send checks."
    ],
    "usage": "npx shadcn@4.21.0 add @bollard/messaging-pack",
    "runtimeDependencies": [],
    "zeroRuntimeDependencies": true
  },
  "docs": "https://bollard-ui.vercel.app/components/messaging-pack",
  "categories": [
    "Starter packs"
  ],
  "type": "registry:ui"
}
