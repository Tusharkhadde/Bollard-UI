{
  "name": "bollard-ui",
  "version": "0.1.0",
  "private": true,
  "description": "React components that stop users from making mistakes. Copy-paste, installable with the shadcn CLI.",
  "license": "MIT",
  "author": "Tushar Khadde (https://devtushar.tech)",
  "homepage": "https://bollard-ui.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tusharkhadde/Bollard-UI.git"
  },
  "bugs": {
    "url": "https://github.com/Tusharkhadde/Bollard-UI/issues"
  },
  "keywords": [
    "react",
    "components",
    "shadcn",
    "shadcn-ui",
    "tailwindcss",
    "ui",
    "form-validation",
    "accessibility",
    "typescript",
    "nextjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components/site lib scripts tests",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/browser/critical-journeys.mjs",
    "test:consumer": "node scripts/smoke-consumer.mjs",
    "registry:build": "node scripts/generate.mjs && shadcn build && node scripts/patch-registry-payloads.mjs",
    "generate": "node scripts/generate.mjs",
    "registry:validate": "node scripts/validate-registry.mjs",
    "headers:stamp": "node scripts/stamp-headers.mjs",
    "manifest:build": "node scripts/build-manifest.mjs"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@floating-ui/react": "^0.27.20",
    "@number-flow/react": "^0.6.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "geist": "^1.7.2",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.60.0",
    "motion": "^14.2.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "playwright": "^1.64.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
